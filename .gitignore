# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# FVM Version Cache
.fvm/

# Muhit sozlamalari: lokal manzil har bir kompyuterda boshqacha (Wi-Fi IP),
# uni `tool/run.ps1 local` avtomatik yozadi. prod/dev fayllari esa git'da.
env/local.json

# Release imzo kaliti - HECH QACHON git'ga tushmasin.
# android/.gitignore key.properties va *.jks ni allaqachon qamraydi; bu esa
# kalit adashib client/ ildiziga qo'yilgan holat uchun zaxira to'siq.
*.jks
*.keystore

# Kotlin incremental build chiqindisi (git'ga tushmasin)
android/.kotlin/
